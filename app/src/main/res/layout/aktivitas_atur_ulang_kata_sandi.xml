<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainAturUlangSandi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- BACKGROUND GELOMBANG BAWAH -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:scaleType="fitXY"
        android:src="@drawable/latar_gelombang_bawah"
        android:contentDescription="Dekorasi Gelombang"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <ImageButton
                    android:id="@+id/tombolKembaliAturUlang"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Kembali" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Planify"
                    android:textColor="#194477"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- JUDUL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Atur Ulang Kata Sandi"
                android:textColor="#182B49"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- DESKRIPSI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Buat kata sandi baru untuk akun kamu.\nPastikan kata sandi mudah diingat dan aman."
                android:textColor="#71819A"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- KATA SANDI BARU FIELD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Kata Sandi Baru"
                android:textColor="#182B49"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/latar_input_kata_sandi"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Ikon Gembok" />

                <EditText
                    android:id="@+id/etKataSandiBaru"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Masukkan kata sandi baru"
                    android:inputType="textPassword"
                    android:textColor="#182B49"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnToggleSandiBaru"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    android:contentDescription="Tampilkan Sandi" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- KONFIRMASI KATA SANDI FIELD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Konfirmasi Kata Sandi"
                android:textColor="#182B49"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/latar_input_kata_sandi"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="Ikon Gembok" />

                <EditText
                    android:id="@+id/etKonfirmasiSandi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="Ulangi kata sandi baru"
                    android:inputType="textPassword"
                    android:textColor="#182B49"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnToggleKonfirmasiSandi"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_visibility_off"
                    android:contentDescription="Tampilkan Konfirmasi Sandi" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- KETENTUAN KATA SANDI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ketentuan kata sandi:"
                android:textColor="#182B49"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="• Minimal 8 karakter"
                android:textColor="#71819A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="• Gunakan kombinasi huruf dan angka"
                android:textColor="#71819A"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- TOMBOL SIMPAN KATA SANDI -->
            <Button
                android:id="@+id/tombolSimpanKataSandi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#194477"
                android:text="Simpan Kata Sandi"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- TEKS INFORMASI BAWAH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Kata sandi kamu akan diperbarui setelah disimpan."
                android:textColor="#71819A"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
