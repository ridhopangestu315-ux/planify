<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainFormTambahJadwal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/tombolKembaliFormJadwal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Tambah Jadwal"
                android:textColor="#172443"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- NAMA JADWAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nama Jadwal *"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pencil"
                android:contentDescription="Pensil" />

            <EditText
                android:id="@+id/etNamaJadwal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Contoh: Kuliah PCD"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- HARI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hari *"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Baris 1 Hari (4 tombol) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:id="@+id/pillSen"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_aktif"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksSen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sen"
                    android:textColor="#3B82F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangSen"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillSel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksSel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sel"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangSel"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillRab"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksRab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rab"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangRab"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillKam"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksKam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kam"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangKam"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>
        </LinearLayout>

        <!-- Baris 2 Hari (3 tombol + space) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:id="@+id/pillJum"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksJum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jum"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangJum"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillSab"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksSab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sab"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangSab"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pillMin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/latar_hari_jadwal_normal"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/teksMin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textColor="#172443"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/centangMin"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Centang" />
            </LinearLayout>

            <!-- Placeholder kosong untuk menyamakan berat 4 kolom -->
            <Space
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- WAKTU (JAM MULAI & JAM SELESAI) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Waktu"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Jam Mulai -->
            <RelativeLayout
                android:id="@+id/layoutJamMulai"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/latar_kotak_input"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/iconJamMulai"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_access_time"
                    android:contentDescription="Jam Mulai" />

                <TextView
                    android:id="@+id/teksJamMulaiTerpilih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/iconJamMulai"
                    android:singleLine="true"
                    android:text="Jam Mulai"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="—"
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <!-- Jam Selesai -->
            <RelativeLayout
                android:id="@+id/layoutJamSelesai"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/latar_kotak_input"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/iconJamSelesai"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_access_time"
                    android:contentDescription="Jam Selesai" />

                <TextView
                    android:id="@+id/teksJamSelesaiTerpilih"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/iconJamSelesai"
                    android:singleLine="true"
                    android:text="Jam Selesai"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- PENGINGAT (SWITCH) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Pengingat"
                android:textColor="#172443"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPengingatJadwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="#FFFFFF"
                app:trackTint="#3B82F6" />
        </RelativeLayout>

        <!-- KARTU WAKTU PENGINGAT (DROPDOWN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/kartuWaktuPengingat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3EAF5"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iconLoncengJadwal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="Lonceng" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/iconLoncengJadwal"
                    android:layout_toStartOf="@id/panahPengingat"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waktu Pengingat"
                        android:textColor="#172443"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/teksWaktuPengingatTerpilih"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="10 menit sebelumnya"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/panahPengingat"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="Panah" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- KETERANGAN (OPSIONAL) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keterangan (Opsional)"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_note"
                android:contentDescription="Catatan" />

            <EditText
                android:id="@+id/etKeteranganJadwal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:gravity="top"
                android:hint="Tambahkan catatan..."
                android:inputType="textMultiLine"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- TOMBOL SIMPAN JADWAL -->
        <Button
            android:id="@+id/tombolSimpanJadwal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#172443"
            android:text="Simpan Jadwal"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
