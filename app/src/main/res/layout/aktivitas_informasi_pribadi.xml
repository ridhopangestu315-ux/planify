<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainInformasiPribadi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/tombolKembaliInformasi"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Informasi Pribadi"
                android:textColor="#172443"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- FOTO PROFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubah foto profil"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/latar_avatar_profil">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="U"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tombolKameraProfil"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/latar_avatar_profil"
                    android:elevation="2dp"
                    android:padding="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="#FFFFFF"
                        android:contentDescription="Kamera" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- NAMA LENGKAP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nama Lengkap *"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutNama"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_person"
                android:contentDescription="Ikon Nama" />

            <EditText
                android:id="@+id/etNamaLengkap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Username"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- EMAIL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email *"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_email"
                android:contentDescription="Ikon Email" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="username@email.com"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- STATUS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Status"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- KOTAK DROPDOWN STATUS -->
        <RelativeLayout
            android:id="@+id/layoutDropdownStatus"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/ikonStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_person"
                android:contentDescription="Ikon Status" />

            <TextView
                android:id="@+id/teksStatusTerpilih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/ikonStatus"
                android:text="Pilih status"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ikonPanahStatus"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Panah" />
        </RelativeLayout>

        <!-- DAFTAR PILIHAN STATUS (DROPDOWN MENU CARD) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/kartuDaftarStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E3EAF5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Opsi 1: Pelajar -->
                <RelativeLayout
                    android:id="@+id/opsiPelajar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/latar_opsi_normal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ikonPelajar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_person"
                        android:contentDescription="Pelajar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/ikonPelajar"
                        android:layout_toStartOf="@id/centangPelajar"
                        android:text="Pelajar"
                        android:textColor="#172443"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/centangPelajar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="Centang" />
                </RelativeLayout>

                <!-- Opsi 2: Pekerja -->
                <RelativeLayout
                    android:id="@+id/opsiPekerja"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/latar_opsi_normal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ikonPekerja"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_work"
                        android:contentDescription="Pekerja" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/ikonPekerja"
                        android:layout_toStartOf="@id/centangPekerja"
                        android:text="Pekerja"
                        android:textColor="#172443"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/centangPekerja"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="Centang" />
                </RelativeLayout>

                <!-- Opsi 3: Ibu Rumah Tangga -->
                <RelativeLayout
                    android:id="@+id/opsiIrt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/latar_opsi_normal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ikonIrt"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_home_outline"
                        android:contentDescription="IRT" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/ikonIrt"
                        android:layout_toStartOf="@id/centangIrt"
                        android:text="Ibu Rumah Tangga"
                        android:textColor="#172443"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/centangIrt"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="Centang" />
                </RelativeLayout>

                <!-- Opsi 4: Lainnya -->
                <RelativeLayout
                    android:id="@+id/opsiLainnya"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/latar_opsi_normal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ikonLainnya"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_more_horiz"
                        android:contentDescription="Lainnya" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/ikonLainnya"
                        android:layout_toStartOf="@id/centangLainnya"
                        android:text="Lainnya"
                        android:textColor="#172443"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/centangLainnya"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_check"
                        android:visibility="gone"
                        android:contentDescription="Centang" />
                </RelativeLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- TOMBOL SIMPAN PERUBAHAN -->
        <Button
            android:id="@+id/tombolSimpanPerubahan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#172443"
            android:text="Simpan Perubahan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
