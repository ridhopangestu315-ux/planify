<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainJadwal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- HEADER: JADWAL & IKON NOTIFIKASI / PROFIL -->
    <TextView
        android:id="@+id/teksJudulJadwal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Jadwal"
        android:textColor="#294A78"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/bingkaiProfilJadwal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/latar_lingkaran_ikon"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulJadwal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/teksJudulJadwal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            android:contentDescription="Profil" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bingkaiNotifikasi"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/latar_lingkaran_ikon"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulJadwal"
        app:layout_constraintEnd_toStartOf="@+id/bingkaiProfilJadwal"
        app:layout_constraintTop_toTopOf="@+id/teksJudulJadwal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notifikasi" />
    </FrameLayout>

    <!-- DESKRIPSI -->
    <TextView
        android:id="@+id/teksDeskripsiJadwal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:text="Atur aktivitas mingguanmu"
        android:textColor="#71819A"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksJudulJadwal" />

    <!-- PILIHAN HARI MINGGUAN (HORIZONTAL SCROLL / LINEAR) -->
    <HorizontalScrollView
        android:id="@+id/scrollHari"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksDeskripsiJadwal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Senin -->
            <LinearLayout
                android:id="@+id/kotakHariSenin"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/teksHariSenin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sen"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/teksTanggalSenin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="11"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selasa -->
            <LinearLayout
                android:id="@+id/kotakHariSelasa"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/teksHariSelasa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sel"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/teksTanggalSelasa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="12"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rabu -->
            <LinearLayout
                android:id="@+id/kotakHariRabu"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rab"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="13"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kamis -->
            <LinearLayout
                android:id="@+id/kotakHariKamis"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kam"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="14"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Jumat -->
            <LinearLayout
                android:id="@+id/kotakHariJumat"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jum"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="15"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sabtu -->
            <LinearLayout
                android:id="@+id/kotakHariSabtu"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sab"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="16"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Minggu -->
            <LinearLayout
                android:id="@+id/kotakHariMinggu"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:background="@drawable/latar_hari_tidak_terpilih"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textColor="#182B49"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="17"
                    android:textColor="#182B49"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- JUDUL JADWAL HARIAN & BADGE -->
    <TextView
        android:id="@+id/teksJudulJadwalHarian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="Jadwal Hari Senin"
        android:textColor="#182B49"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollHari" />

    <TextView
        android:id="@+id/badgeJumlahJadwal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:background="@drawable/latar_badge_jadwal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="0 Jadwal"
        android:textColor="#16A34A"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulJadwalHarian"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/teksJudulJadwalHarian" />

    <!-- EMPTY STATE KONTainer -->
    <LinearLayout
        android:id="@+id/tataLetakKosongJadwal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/latar_kegiatan_kosong"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tombolTambahJadwal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksJudulJadwalHarian">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_calendar_clock"
            android:contentDescription="Ilustrasi Jadwal Kosong" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Belum ada jadwal"
            android:textColor="#182B49"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tambahkan jadwal pertama untuk mengatur aktivitasmu."
            android:textColor="#71819A"
            android:textSize="14sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- TOMBOL TAMBAH JADWAL -->
    <Button
        android:id="@+id/tombolTambahJadwal"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#294A78"
        android:text="+ Tambah Jadwal"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahJadwal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BOTTOM NAVIGATION (NAVIGASI BAWAH) -->
    <LinearLayout
        android:id="@+id/navigasiBawahJadwal"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/latar_navigasi_bawah"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Menu 1: Beranda -->
        <LinearLayout
            android:id="@+id/menuBerandaJadwal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Beranda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 2: Jadwal (Aktif) -->
        <LinearLayout
            android:id="@+id/menuJadwalJadwal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/latar_menu_terpilih"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Jadwal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Jadwal"
                android:textColor="#294A78"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menu 3: Catatan -->
        <LinearLayout
            android:id="@+id/menuCatatanJadwal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_note"
                android:contentDescription="Catatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catatan"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 4: Kegiatan -->
        <LinearLayout
            android:id="@+id/menuKegiatanJadwal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checklist"
                android:contentDescription="Kegiatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kegiatan"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 5: Kalender -->
        <LinearLayout
            android:id="@+id/menuKalenderJadwal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_days"
                android:contentDescription="Kalender" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kalender"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
