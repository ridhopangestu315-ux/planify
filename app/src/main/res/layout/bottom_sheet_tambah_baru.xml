<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/latar_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="36dp">

    <!-- HANDLE -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/latar_handle_bottom_sheet" />

    <!-- HEADER: TOMBOL TUTUP (X) & JUDUL -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah Baru"
                android:textColor="#172443"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pilih jenis data yang ingin kamu tambahkan"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/tombolTutupBottomSheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/latar_lingkaran_ikon"
            android:src="@drawable/ic_close"
            android:contentDescription="Tutup" />
    </RelativeLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- KARTU 1: TAMBAH KEGIATAN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/kartuTambahKegiatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="#E3EAF5"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/iconKegiatanBs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="@drawable/latar_kotak_ikon_biru">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_checklist"
                    android:contentDescription="Kegiatan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconKegiatanBs"
                android:layout_toStartOf="@id/arrowKegiatanBs"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tambah Kegiatan"
                    android:textColor="#172443"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Buat tugas, deadline, atau kegiatan baru"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/arrowKegiatanBs"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Panah" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- KARTU 2: TAMBAH JADWAL -->
    <androidx.cardview.widget.CardView
        android:id="@+id/kartuTambahJadwal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="#E3EAF5"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/iconJadwalBs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="@drawable/latar_kotak_ikon_ungu">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Jadwal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconJadwalBs"
                android:layout_toStartOf="@id/arrowJadwalBs"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tambah Jadwal"
                    android:textColor="#172443"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Atur jadwal belajar, kuliah, atau agenda rutin"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/arrowJadwalBs"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Panah" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- KARTU 3: BUAT CATATAN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/kartuBuatCatatan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="#E3EAF5"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/iconCatatanBs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:background="@drawable/latar_kotak_ikon_hijau">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    android:contentDescription="Catatan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/iconCatatanBs"
                android:layout_toStartOf="@id/arrowCatatanBs"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buat Catatan"
                    android:textColor="#172443"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Simpan ide, materi, atau catatan penting"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:id="@+id/arrowCatatanBs"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Panah" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
