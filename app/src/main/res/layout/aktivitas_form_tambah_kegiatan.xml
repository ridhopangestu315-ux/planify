<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainFormTambahKegiatan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/tombolKembaliFormKegiatan"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Tambah Kegiatan"
                android:textColor="#172443"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- JUDUL KEGIATAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Judul Kegiatan *"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_pencil"
                android:contentDescription="Pencil" />

            <EditText
                android:id="@+id/etJudulKegiatan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Tugas PCD"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- DESKRIPSI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Deskripsi (Opsional)"
            android:textColor="#172443"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/latar_kotak_input"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_note"
                android:contentDescription="Note" />

            <EditText
                android:id="@+id/etDeskripsiKegiatan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:gravity="top"
                android:hint="Tambahkan detail kegiatan..."
                android:inputType="textMultiLine"
                android:textColor="#172443"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- TANGGAL DEADLINE & WAKTU (BERDAMPINGAN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Tanggal Deadline -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal Deadline *"
                    android:textColor="#172443"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutPilihTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/latar_kotak_input"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iconKalender"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="Kalender" />

                    <TextView
                        android:id="@+id/teksTanggalTerpilih"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/iconKalender"
                        android:layout_toStartOf="@id/panahKalender"
                        android:singleLine="true"
                        android:text="Pilih tanggal"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/panahKalender"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Panah" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Waktu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waktu"
                    android:textColor="#172443"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/layoutPilihWaktu"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/latar_kotak_input"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iconJam"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_access_time"
                        android:contentDescription="Jam" />

                    <TextView
                        android:id="@+id/teksWaktuTerpilih"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@id/iconJam"
                        android:layout_toStartOf="@id/panahJam"
                        android:singleLine="true"
                        android:text="Pilih waktu"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/panahJam"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Panah" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PRIORITAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_flag"
                android:contentDescription="Bendera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Prioritas"
                android:textColor="#172443"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/pillRendah"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/latar_prioritas_tidak_aktif"
                android:gravity="center"
                android:text="● Rendah"
                android:textColor="#16A34A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillSedang"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/latar_prioritas_sedang"
                android:gravity="center"
                android:text="● Sedang"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pillTinggi"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/latar_prioritas_tidak_aktif"
                android:gravity="center"
                android:text="● Tinggi"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- KATEGORI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_checklist"
                android:contentDescription="Grid" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Kategori"
                android:textColor="#172443"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layoutDropdownKategori"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/latar_kotak_input"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/teksKategoriTerpilih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Pilih kategori"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="Panah" />
        </RelativeLayout>

        <!-- KARTU PENGINGAT -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeColor="#E3EAF5"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iconLonceng"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="Lonceng" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/iconLonceng"
                    android:text="Ingatkan Saya"
                    android:textColor="#172443"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchIngatkanSaya"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="#3B82F6" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- TOMBOL SIMPAN KEGIATAN -->
        <Button
            android:id="@+id/tombolSimpanKegiatan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#172443"
            android:text="Simpan Kegiatan"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
