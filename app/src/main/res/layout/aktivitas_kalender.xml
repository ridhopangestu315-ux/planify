<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainKalender"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahKalender"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <!-- HEADER: KALENDER & PROFIL -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/teksJudulKalender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kalender"
                    android:textColor="#182B49"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/bingkaiProfilKalender"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/latar_lingkaran_ikon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:contentDescription="Profil" />
                </FrameLayout>
            </RelativeLayout>

            <!-- DESKRIPSI -->
            <TextView
                android:id="@+id/teksDeskripsiKalender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                android:text="Lihat jadwal berdasarkan tanggal"
                android:textColor="#71819A"
                android:textSize="14sp" />

            <!-- KARTU KALENDER BULANAN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/kartuKalenderBulanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- NAVIGASI BULAN & TAHUN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/teksBulanTahun"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="November 2026"
                            android:textColor="#182B49"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/tombolBulanSebelumnya"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_chevron_left"
                            android:contentDescription="Bulan Sebelumnya" />

                        <ImageButton
                            android:id="@+id/tombolBulanBerikutnya"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="Bulan Berikutnya" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <!-- HEADER HARI (M S S R K J S) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="R" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="K" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="J" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#71819A" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <!-- GRID TANGGAL (RECYCLERVIEW) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewGridKalender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- INFORMASI KEGIATAN BERDASARKAN TANGGAL -->
            <TextView
                android:id="@+id/teksJudulInfoTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Kegiatan • 11 November"
                android:textColor="#182B49"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- EMPTY STATE / DAFTAR KEGIATAN TANGGAL -->
            <LinearLayout
                android:id="@+id/tataLetakKosongKalender"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/latar_keadaan_kosong_kalender"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada Jadwal"
                    android:textColor="#182B49"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RECYCLERVIEW KEGIATAN TANGGAL -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewKegiatanTanggal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- FLOATING ACTION BUTTON (TAMBAH JADWAL) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/tombolTambahKalender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#294A78"
        android:contentDescription="Tambah Jadwal"
        android:src="@drawable/ic_add"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahKalender"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION (NAVIGASI BAWAH) -->
    <LinearLayout
        android:id="@+id/navigasiBawahKalender"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/latar_navigasi_bawah"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Menu 1: Beranda -->
        <LinearLayout
            android:id="@+id/menuBerandaKalender"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Beranda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 2: Jadwal -->
        <LinearLayout
            android:id="@+id/menuJadwalKalender"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Jadwal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Jadwal"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 3: Catatan -->
        <LinearLayout
            android:id="@+id/menuCatatanKalender"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_note"
                android:contentDescription="Catatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catatan"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 4: Kegiatan -->
        <LinearLayout
            android:id="@+id/menuKegiatanKalender"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checklist"
                android:contentDescription="Kegiatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kegiatan"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 5: Kalender (Aktif) -->
        <LinearLayout
            android:id="@+id/menuKalenderKalender"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/latar_menu_terpilih"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_days"
                android:contentDescription="Kalender" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kalender"
                android:textColor="#294A78"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
