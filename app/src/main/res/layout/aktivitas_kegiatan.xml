<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainKegiatan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC">

    <!-- HEADER: KEGIATAN, NOTIFIKASI & PROFIL -->
    <TextView
        android:id="@+id/teksJudulKegiatan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Kegiatan"
        android:textColor="#182B49"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/bingkaiProfilKegiatan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/latar_lingkaran_ikon"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulKegiatan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/teksJudulKegiatan">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            android:contentDescription="Profil" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bingkaiNotifikasiKegiatan"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/latar_lingkaran_ikon"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulKegiatan"
        app:layout_constraintEnd_toStartOf="@+id/bingkaiProfilKegiatan"
        app:layout_constraintTop_toTopOf="@+id/teksJudulKegiatan">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notification"
            android:contentDescription="Notifikasi" />
    </FrameLayout>

    <!-- DESKRIPSI -->
    <TextView
        android:id="@+id/teksDeskripsiKegiatan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:text="Atur tugas dan pantau progresmu"
        android:textColor="#71819A"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksJudulKegiatan" />

    <!-- FILTER STATUS KEGIATAN -->
    <LinearLayout
        android:id="@+id/layoutFilterKegiatan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksDeskripsiKegiatan">

        <TextView
            android:id="@+id/filterSemuaKegiatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/latar_filter_aktif"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Semua"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterPendingKegiatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/latar_filter_tidak_aktif"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Pending"
            android:textColor="#71819A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterSelesaiKegiatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/latar_filter_tidak_aktif"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Selesai"
            android:textColor="#71819A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- JUDUL DAFTAR KEGIATAN & JUMLAH -->
    <TextView
        android:id="@+id/teksJudulDaftar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Daftar kegiatan"
        android:textColor="#182B49"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutFilterKegiatan" />

    <TextView
        android:id="@+id/teksJumlahTugasAktif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="0 tugas aktif"
        android:textColor="#71819A"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@+id/teksJudulDaftar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/teksJudulDaftar" />

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/tataLetakKosongKegiatan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/latar_kegiatan_kosong"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahKegiatan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksJudulDaftar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum ada Kegiatan"
            android:textColor="#182B49"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mulai dari kegiatan paling penting hari ini."
            android:textColor="#71819A"
            android:textSize="14sp"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- RECYCLER VIEW DAFTAR KEGIATAN -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewKegiatan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahKegiatan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/teksJudulDaftar" />

    <!-- FLOATING ACTION BUTTON (TAMBAH KEGIATAN) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/tombolTambahKegiatan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#294A78"
        android:contentDescription="Tambah Kegiatan"
        android:src="@drawable/ic_add"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@+id/navigasiBawahKegiatan"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION (NAVIGASI BAWAH) -->
    <LinearLayout
        android:id="@+id/navigasiBawahKegiatan"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/latar_navigasi_bawah"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Menu 1: Beranda -->
        <LinearLayout
            android:id="@+id/menuBerandaKegiatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Beranda" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 2: Jadwal -->
        <LinearLayout
            android:id="@+id/menuJadwalKegiatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Jadwal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Jadwal"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 3: Catatan -->
        <LinearLayout
            android:id="@+id/menuCatatanKegiatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_note"
                android:contentDescription="Catatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catatan"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Menu 4: Kegiatan (Aktif) -->
        <LinearLayout
            android:id="@+id/menuKegiatanKegiatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/latar_menu_terpilih"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checklist"
                android:contentDescription="Kegiatan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kegiatan"
                android:textColor="#294A78"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Menu 5: Kalender -->
        <LinearLayout
            android:id="@+id/menuKalenderKegiatan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calendar_days"
                android:contentDescription="Kalender" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kalender"
                android:textColor="#71819A"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
