<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Planify">

        <!-- Splash Screen Activity -->
        <activity
            android:name=".AktivitasPembuka"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".AktivitasMasuk"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity -->
        <activity
            android:name=".AktivitasDaftar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Forgot Password Activity -->
        <activity
            android:name=".AktivitasLupaKataSandi"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- OTP Verification Activity -->
        <activity
            android:name=".AktivitasVerifikasiOtp"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reset Password Activity -->
        <activity
            android:name=".AktivitasAturUlangKataSandi"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard Activity -->
        <activity
            android:name=".AktivitasUtama"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Schedule Activity -->
        <activity
            android:name=".AktivitasJadwal"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Schedule Form Activity -->
        <activity
            android:name=".AktivitasFormTambahJadwal"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notes Activity -->
        <activity
            android:name=".AktivitasCatatan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Note Form Activity -->
        <activity
            android:name=".AktivitasFormTambahCatatan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Calendar Activity -->
        <activity
            android:name=".AktivitasKalender"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activities Activity -->
        <activity
            android:name=".AktivitasKegiatan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Activity Form Activity -->
        <activity
            android:name=".AktivitasFormTambahKegiatan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile Activity -->
        <activity
            android:name=".AktivitasProfil"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Personal Info Activity -->
        <activity
            android:name=".AktivitasInformasiPribadi"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification Hub Activity -->
        <activity
            android:name=".AktivitasPengaturanNotifikasi"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification Schedule Settings Activity -->
        <activity
            android:name=".AktivitasNotifikasiJadwal"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notification Activity Settings Activity -->
        <activity
            android:name=".AktivitasNotifikasiKegiatan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Display Preference Activity -->
        <activity
            android:name=".AktivitasTampilan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Language Preference Activity -->
        <activity
            android:name=".AktivitasBahasa"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
